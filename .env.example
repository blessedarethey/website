# Copy this file to .env for local development.
# In production these are set as environment variables in the Netlify dashboard instead.

SANITY_PROJECT_ID=s7qx1s92
SANITY_DATASET=production
# Read token — only needed if content is ever fetched as a draft/private dataset.
# Leave blank for now; the published dataset is public-readable by default.
SANITY_API_TOKEN=

# Write token — required for the homepage email-signup forms to work
# (src/pages/api/subscribe.ts). Create one at manage.sanity.io → your
# project → API → Tokens → Add API token, permission "Editor", then paste
# it here (and as a Netlify environment variable in production).
SANITY_WRITE_TOKEN=
