---
import Layout from '../layouts/Layout.astro';

const visionPillars = [
  {
    accent: 'var(--color-amber)',
    title: 'Meets them in the present',
    body: 'Each level is written for a specific stage of development — what a fourth grader is ready to hear is not what a senior needs. Nothing is taught before its time, and nothing is withheld once it is due.',
  },
  {
    accent: 'var(--color-rose)',
    title: 'Deepens as they mature',
    body: 'Anatomy, relationships, and the dignity of the person recur at every level. Each return goes further, so students build on what they already know instead of starting over.',
  },
  {
    accent: 'var(--color-sage)',
    title: 'Continues past high school',
    body: 'Our goal reaches beyond graduation: college and young adult formation, preparation for engaged couples, and ongoing formation for the married — including fertility awareness–based methods and the real questions marriage brings.',
  },
];
---

<Layout
  title="Home"
  description="Blessed Are They is a Catholic nonprofit seeking to unite scientific accuracy and Catholic faith in forming the next generation — uncompromisingly faithful to the Church."
  active="home"
>
  <section class="hero">
    <div class="hero__content">
      <img
        class="hero__wordmark"
        src="/uploads/slogan1-cream.png"
        alt="blessed are they"
      />
      <p class="hero__headline">
        There is a gap in Catholic culture.<br />
        We are bridging it.
      </p>
      <p class="hero__subhead">
        Blessed Are They is a Catholic nonprofit seeking to unite scientific
        accuracy and Catholic faith in forming<br />
        the next generation — uncompromisingly faithful to the Church.
      </p>
      <a href="#mission" class="button">Learn about our mission</a>
    </div>
  </section>

  <section id="mission" class="mission">
    <div class="section-intro">
      <p class="eyebrow">The mission</p>
      <span class="rule" />
      <p class="mission__headline">Total cultural change.</p>
      <p class="mission__body">
        Not a better pamphlet. Not one good lesson. A generation formed to
        know how and why their bodies<br />
        were made — until the truth of the human person is simply the air
        Catholic families breathe.<br />
        That&rsquo;s the gap <i>Blessed Are They</i> exists to close.
      </p>
    </div>
  </section>

  <section class="vision">
    <div class="vision__inner">
      <div class="section-intro vision__intro">
        <p class="eyebrow">The vision</p>
        <span class="rule" />
        <h2 class="vision__headline">
          Culture changes one classroom and one kitchen table at a time.<br />
           We start with the curriculum.
        </h2>
        <p class="vision__lede">
          This is not a lesson delivered once. It is one message that grows
          with the person — returned to at every stage of development, taught
          at the level the student is ready for, deepening as they mature.
        </p>
      </div>

      <div class="vision__grid">
        {
          visionPillars.map((pillar) => (
            <div class="vision__card" style={`--accent: ${pillar.accent}`}>
              <p class="vision__card-title">{pillar.title}</p>
              <p class="vision__card-body">{pillar.body}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section id="donate" class="donate">
    <div class="donate__inner">
      <h2 class="donate__heading">The plan</h2>
      <p class="donate__tagline">Phase I is where the bridge begins.</p>
      <ul class="donate__list">
        <li>Four lessons</li>
        <li>Thirteen videos</li>
        <li>Guides for the classroom</li>
        <li>Guides for home</li>
      </ul>

      <div class="donate__progress">
        <div class="donate__progress-row">
          <span>Phase I, grades 4–5</span>
          <span>Estimated cost $149,000</span>
        </div>
        <div class="donate__progress-track">
          <div class="donate__progress-fill" />
        </div>
      </div>

      <a href="/donate" class="button button--large">Donate</a>
      <p class="donate__note">
        Blessed Are They is a 501(c)(3); gifts are tax-deductible.
      </p>
    </div>
  </section>

  <section class="newsletter">
    <div class="newsletter__inner">
      <p class="newsletter__eyebrow">Stay connected</p>
      <h2 class="newsletter__headline">Join the BAT village, via inbox</h2>
      <p class="newsletter__body">
        One short email when a something new has sprouted...
      </p>
      <form class="signupRow" onsubmit="event.preventDefault()">
        <input
          type="email"
          placeholder="you@email.com"
          class="emailInput"
          aria-label="Email address"
        />
        <button type="submit" class="button">Sign up</button>
      </form>
    </div>
  </section>

  <section class="early-access">
    <div class="early-access__inner">
      <p class="early-access__eyebrow">Early access</p>
      <h2 class="early-access__headline">Be the first to have it!</h2>
      <p class="early-access__body">
        Phase I is four lessons, thirteen videos, and the educator and parent
        guides that go with them.<br />
        Put your name on the list and you will hear from us before it opens to
        anyone else.
      </p>
      <form class="early-access__signup signupRow" onsubmit="event.preventDefault()">
        <input
          type="email"
          placeholder="you@email.com"
          class="emailInput"
          aria-label="Email address"
        />
        <button type="submit" class="button">Join the list</button>
      </form>
      <p class="early-access__note">
        Bringing it to a school or parish?{' '}
        <a href="mailto:hello@blessedarethey.com?subject=Early%20access%3A%20Grades%204%2F5%20curriculum">
          Email us directly
        </a>
      </p>
    </div>
  </section>
</Layout>

<style>
  /* ── Hero ─────────────────────────────────────────────────────────── */

  .hero {
    position: relative;
    min-height: calc(100vh - 140px);
    display: flex;
    background: var(--color-charcoal-light);
    overflow: hidden;
  }

  .hero__content {
    position: relative;
    flex: 1;
    box-sizing: border-box;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 26px;
    padding: 56px 48px;
    text-align: center;
  }

  .hero__wordmark {
    width: 100%;
    max-width: 620px;
    height: auto;
    display: block;
  }

  .hero__headline {
    font-family: var(--font-serif);
    font-size: 36px;
    line-height: 1.3;
    color: var(--color-cream);
    margin: 0;
    max-width: 780px;
    text-wrap: pretty;
  }

  .hero__subhead {
    font-size: 18px;
    line-height: 1.7;
    color: var(--color-stone);
    margin: 0;
    max-width: 980px;
    text-wrap: pretty;
  }

  /* ── Shared section chrome ───────────────────────────────────────── */

  .section-intro {
    max-width: 980px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 20px;
    text-align: center;
  }

  /* ── Mission ──────────────────────────────────────────────────────── */

  .mission {
    padding: 48px 48px 52px;
    background: var(--color-cream);
    border-bottom: 1px solid var(--color-stone);
  }

  .mission__headline {
    font-family: var(--font-serif);
    font-size: 26px;
    line-height: 1.3;
    margin: 0;
    max-width: 800px;
    color: var(--color-heading);
    text-wrap: pretty;
  }

  .mission__body {
    font-size: 20px;
    line-height: 1.6;
    margin: 0;
    max-width: 1080px;
    text-wrap: pretty;
  }

  /* ── Vision ───────────────────────────────────────────────────────── */

  .vision {
    padding: 40px 48px 48px;
    background: var(--color-white);
    border-top: 1px solid var(--color-stone);
  }

  .vision__inner {
    max-width: 1180px;
    margin: 0 auto;
  }

  .vision__intro {
    max-width: 900px;
    margin: 0 auto 52px;
  }

  .vision__headline {
    font-family: var(--font-serif);
    font-weight: 400;
    font-size: 26px;
    line-height: 1.2;
    margin: 0;
    color: var(--color-heading);
    text-wrap: pretty;
  }

  .vision__lede {
    font-size: 18px;
    line-height: 1.7;
    opacity: 0.82;
    margin: 0;
    text-wrap: pretty;
  }

  .vision__grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 32px;
    align-items: stretch;
  }

  .vision__card {
    padding-top: 26px;
    border-top: 2px solid var(--accent, var(--color-amber));
  }

  .vision__card-title {
    font-family: var(--font-body);
    font-size: 26px;
    line-height: 1.25;
    margin: 0 0 12px;
    color: var(--color-heading);
    text-align: center;
    text-wrap: balance;
    text-transform: uppercase;
  }

  .vision__card-body {
    font-size: 16px;
    line-height: 1.7;
    opacity: 0.82;
    margin: 0;
    text-align: center;
    text-wrap: pretty;
  }

  /* ── Donate ───────────────────────────────────────────────────────── */

  .donate {
    position: relative;
    overflow: hidden;
    background: var(--color-charcoal-light);
  }

  .donate__inner {
    position: relative;
    max-width: 780px;
    margin: 0 auto;
    padding: 56px 48px 64px;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    color: var(--color-stone);
  }

  .donate__heading {
    font-size: 42px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    font-weight: 400;
    line-height: 1.2;
    margin: 0 0 22px;
    color: var(--color-stone);
    text-wrap: pretty;
  }

  .donate__tagline {
    font-family: var(--font-serif);
    font-size: 24px;
    line-height: 1.35;
    margin: 0 0 18px;
    text-wrap: pretty;
  }

  .donate__list {
    list-style: none;
    margin: 0 0 36px;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 10px;
    font-size: 19px;
    line-height: 1.4;
  }

  .donate__progress {
    width: 100%;
    max-width: 520px;
    margin-bottom: 36px;
  }

  .donate__progress-row {
    display: flex;
    justify-content: space-between;
    font-size: 14px;
    margin-bottom: 10px;
  }

  .donate__progress-track {
    height: 8px;
    background: rgba(253, 244, 230, 0.25);
    border-radius: 999px;
    overflow: hidden;
  }

  .donate__progress-fill {
    width: 22%;
    height: 100%;
    background: var(--color-sage);
  }

  .donate__note {
    margin: 20px 0 0;
    font-size: 14px;
  }

  /* ── Newsletter / early access ───────────────────────────────────── */

  .newsletter {
    padding: 28px 48px 32px;
    background: var(--color-cream);
    border-top: 1px solid var(--color-stone);
    border-bottom: 1px solid var(--color-stone);
  }

  .newsletter__inner,
  .early-access__inner {
    max-width: 760px;
    margin: 0 auto;
    text-align: center;
  }

  .newsletter__eyebrow {
    margin: 0 0 14px;
    font-size: 38px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--color-heading);
  }

  .newsletter__headline {
    font-family: var(--font-serif);
    font-weight: 700;
    font-size: 20px;
    line-height: 1.18;
    margin: 0 0 16px;
    color: var(--color-heading);
    text-wrap: pretty;
  }

  .newsletter__body {
    font-size: 18px;
    line-height: 1.65;
    opacity: 0.8;
    margin: 0 0 32px;
    text-wrap: pretty;
  }

  .early-access {
    padding: 40px 48px 48px;
    background: var(--color-stone);
  }

  .early-access__inner {
    max-width: 820px;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .early-access__eyebrow {
    margin: 0 0 14px;
    font-size: 40px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--color-heading);
  }

  .early-access__headline {
    font-family: var(--font-serif);
    font-weight: 700;
    font-size: 20px;
    line-height: 1.15;
    margin: 0 0 18px;
    color: var(--color-heading);
    text-wrap: pretty;
  }

  .early-access__body {
    font-size: 18px;
    line-height: 1.68;
    opacity: 0.84;
    margin: 0 0 34px;
    text-wrap: pretty;
  }

  .early-access__signup {
    width: 100%;
  }

  .early-access__note {
    margin: 22px 0 0;
    font-size: 15px;
  }
</style>
