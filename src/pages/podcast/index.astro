---
import Layout from '../../layouts/Layout.astro';
import { getEpisodes } from '../../lib/podcast';

let episodes: Awaited<ReturnType<typeof getEpisodes>> = [];
let fetchError = false;

try {
  episodes = await getEpisodes();
} catch {
  // Feed host down, URL changed, or malformed XML — render the page
  // instead of crashing the build.
  fetchError = true;
}
---

<Layout title="Podcast" description="Blessed Are They podcast" active="podcast">
  <h1>Podcast</h1>

  {fetchError && (
    <p>
      Couldn't load episodes from the podcast feed right now — try again
      shortly.
    </p>
  )}

  {!fetchError && episodes.length === 0 && <p>No episodes published yet.</p>}

  <ul>
    {episodes.map((ep) => (
      <li>
        <a href={`/podcast/${ep.slug}`}>{ep.title}</a>
        {ep.description && <p>{ep.description}</p>}
      </li>
    ))}
  </ul>
</Layout>
