---
import Layout from '../layouts/Layout.astro';

const WE_BRING = [
  'Presenters and the full program',
  'Décor that sets the tone',
  'All promotional and distribution materials',
  'A welcome email to parents ahead of the session',
  'Full media package',
];

const YOU_PROVIDE = [
  'The space',
  'Tables and seating',
  'Audio and visual setup',
  'Hospitality',
  'Promotion to your own families',
];

const UPCOMING = [
  {
    name: 'St. Cecilia Academy',
    detail: 'Evening program · 6:00–7:15 pm',
    date: 'September 22 & 23',
  },
  {
    name: 'Pope Saint John Paul II Preparatory School',
    detail: 'Daytime program',
    date: 'October 1',
  },
];
---

<Layout
  title="Events"
  description="Blessed Are They live events — mother-daughter and father-son evenings for schools, parishes, and groups."
  active="events"
>
  <section class="hero">
    <h1 class="heroTitle">Events</h1>
  </section>

  <section class="intro">
    <div class="introInner">
      <h2 class="introHeading">Live events</h2>
      <div class="tagRow">
        <span class="tagRule" />
        <p class="tag">Schools &middot; Parishes &middot; Special Groups</p>
        <span class="tagRule" />
      </div>
      <p class="introBody">
        We bring the presenters and the program. <br />You provide the
        space and the community.
      </p>
    </div>
  </section>

  <section class="momDad">
    <div class="momDadInner">
      <div class="momDadText">
        <h2 class="momDadHeading">
          Mother-Daughter &amp; <br />Father-Son Events
        </h2>
        <p class="momDadSub">
          Retreat-style, designed for connection &amp; hosted in your space
        </p>
        <span class="rule" />
        <p class="momDadBody">
          Parent and child attend together, hearing didactic sessions and
          then breaking out to discuss what they heard — time for
          reflection, connection, and learning. The goal is language: words
          for the difficult topics of reproductive health, given through
          the lens of faith in words you understand... leaving with a
          foundation to build on.
        </p>
        <a class="outlineButton" href="mailto:hello@blessedarethey.com">
          Inquire Today
        </a>
      </div>
      <div class="momDadArt">
        <div class="artCell">
          <svg
            viewBox="0 0 124 176"
            preserveAspectRatio="xMidYMid meet"
            role="img"
            aria-label="Mother and daughter"
            fill="none"
            stroke="#3A3A42"
            stroke-width="4"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <path d="M14,150 L110,150" stroke-width="3.4"></path>
            <circle cx="42" cy="40" r="13"></circle>
            <path
              d="M42,53 C31,56 27,66 27,78 L23,112 L61,112 L57,78 C57,66 53,56 42,53 Z"
            ></path>
            <path d="M35,112 L34,150"></path>
            <path d="M49,112 L50,150"></path>
            <path d="M57,74 C66,84 72,94 76,104"></path>
            <circle cx="88" cy="74" r="10.5"></circle>
            <path
              d="M88,84.5 C79,87 76,94 76,103 L74,124 L102,124 L100,103 C100,94 97,87 88,84.5 Z"
            ></path>
            <path d="M82,124 L81,150"></path>
            <path d="M94,124 L95,150"></path>
            <path d="M76,102 C79,101 78,101 76,104"></path>
          </svg>
        </div>
        <div class="artCell artCell--offset">
          <svg
            viewBox="0 0 124 176"
            preserveAspectRatio="xMidYMid meet"
            role="img"
            aria-label="Father and son"
            fill="none"
            stroke="#3A3A42"
            stroke-width="4"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <path d="M14,150 L110,150" stroke-width="3.4"></path>
            <circle cx="42" cy="40" r="13"></circle>
            <path
              d="M42,53 C32,55 28,63 28,74 L28,104 L56,104 L56,74 C56,63 52,55 42,53 Z"
            ></path>
            <path d="M34,104 L32,150"></path>
            <path d="M50,104 L52,150"></path>
            <path d="M56,74 C65,84 71,94 75,104"></path>
            <circle cx="88" cy="74" r="10.5"></circle>
            <path
              d="M88,84.5 C80,86 77,92 77,100 L77,120 L99,120 L99,100 C99,92 96,86 88,84.5 Z"
            ></path>
            <path d="M81,120 L79,150"></path>
            <path d="M95,120 L97,150"></path>
            <path d="M77,101 C79,101 78,102 75,104"></path>
          </svg>
        </div>
      </div>
    </div>
  </section>

  <section class="together">
    <div class="togetherInner">
      <div class="togetherIntro">
        <h2 class="togetherHeading">How it comes together</h2>
        <p class="togetherTag">
          Typical run time 1 hr 15 min &middot; Evening or weekend sessions
        </p>
      </div>
      <div class="togetherGrid">
        <div class="togetherCard">
          <h3 class="togetherCardTitle">We Bring:</h3>
          <ul class="togetherList">
            {WE_BRING.map((item) => (
              <li>
                <span class="bullet">&bull;</span>
                <span>{item}</span>
              </li>
            ))}
          </ul>
        </div>
        <div class="togetherCard">
          <h3 class="togetherCardTitle">You Provide:</h3>
          <ul class="togetherList">
            {YOU_PROVIDE.map((item) => (
              <li>
                <span class="bullet">&bull;</span>
                <span>{item}</span>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </div>
  </section>

  <section class="upcoming">
    <div class="upcomingInner">
      <div class="upcomingIntro">
        <h2 class="upcomingHeading">Upcoming Events</h2>
        <p class="upcomingTag">Fall 2026</p>
      </div>
      <div>
        {UPCOMING.map((ev, i) => (
          <div
            class="eventRow"
            style={{
              borderBottom:
                i === UPCOMING.length - 1 ? '1px solid var(--color-stone)' : 'none',
            }}
          >
            <div>
              <p class="eventName">{ev.name}</p>
              <p class="eventDetail">{ev.detail}</p>
            </div>
            <p class="eventDate">{ev.date}</p>
          </div>
        ))}
      </div>
      <div class="upcomingCta">
        <p class="upcomingCtaBody">
          Want your school, parish or group on the calendar? We are booking
          now.
        </p>
        <a class="button button--large" href="mailto:hello@blessedarethey.com">
          Inquire Today
        </a>
      </div>
    </div>
  </section>
</Layout>

<style>
  .hero {
    padding: 40px 48px 44px;
    background: var(--color-charcoal-light);
  }

  .heroTitle {
    max-width: 920px;
    margin: 0 auto;
    text-align: center;
    font-family: var(--font-serif);
    font-weight: 700;
    font-size: 46px;
    line-height: 1.15;
    color: var(--color-cream);
  }

  .intro {
    padding: 48px 48px 52px;
    background: var(--color-stone);
    border-bottom: 1px solid #d8b9ab;
  }

  .introInner {
    max-width: 1180px;
    margin: 0 auto;
    text-align: center;
  }

  .introHeading {
    font-size: 42px;
    font-weight: 400;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    line-height: 1.06;
    margin: 0 0 26px;
    color: var(--color-heading);
  }

  .tagRow {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 18px;
    margin-bottom: 26px;
  }

  .tagRule {
    display: block;
    width: 42px;
    height: 2px;
    background: var(--color-amber);
  }

  .tag {
    margin: 0;
    font-size: 15px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--color-charcoal-light);
  }

  .introBody {
    font-size: 21px;
    line-height: 1.6;
    opacity: 0.85;
    margin: 0 auto;
    max-width: 700px;
    text-wrap: pretty;
  }

  .momDad {
    padding: 40px 48px 48px;
    background: var(--color-white);
  }

  .momDadInner {
    max-width: 1180px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    gap: 64px;
    align-items: center;
  }

  .momDadHeading {
    font-size: 32px;
    font-weight: 400;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    line-height: 1.18;
    margin: 0 0 18px;
    color: var(--color-heading);
    text-wrap: pretty;
  }

  .momDadSub {
    margin: 0 0 24px;
    font-size: 20px;
    color: var(--color-charcoal-light);
    font-family: 'Roca', var(--font-serif);
    line-height: 1.2;
  }

  .momDad .rule {
    margin-bottom: 24px;
  }

  .momDadBody {
    font-size: 18px;
    line-height: 1.68;
    opacity: 0.84;
    margin: 0 0 28px;
    text-wrap: pretty;
  }

  .outlineButton {
    display: inline-block;
    padding: 15px 36px;
    border: 1px solid var(--color-deep-rose);
    border-radius: 999px;
    font-size: 16px;
    color: var(--color-deep-rose);
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  .outlineButton:hover {
    background: var(--color-deep-rose);
    color: var(--color-cream);
  }

  .momDadArt {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 20px;
  }

  .artCell {
    aspect-ratio: 3 / 4;
    min-width: 0;
    overflow: hidden;
    padding: 16px;
    box-sizing: border-box;
  }

  .artCell svg {
    display: block;
    width: 100%;
    height: 100%;
  }

  .artCell--offset {
    margin-top: 32px;
  }

  .together {
    padding: 40px 48px 48px;
    background: var(--color-cream);
    border-top: 1px solid var(--color-stone);
  }

  .togetherInner {
    max-width: 1180px;
    margin: 0 auto;
  }

  .togetherIntro {
    text-align: center;
    margin-bottom: 44px;
  }

  .togetherHeading {
    font-size: 42px;
    font-weight: 400;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    line-height: 1.2;
    margin: 0 0 16px;
    color: var(--color-heading);
  }

  .togetherTag {
    margin: 0;
    font-size: 15px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--color-charcoal-light);
  }

  .togetherGrid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 32px;
  }

  .togetherCard {
    background: var(--color-white);
    border: 1px solid var(--color-stone);
    border-radius: 16px;
    padding: 28px 32px;
  }

  .togetherCardTitle {
    font-family: 'Roca', var(--font-serif);
    font-weight: 400;
    font-size: 28px;
    margin: 0 0 14px;
  }

  .togetherList {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 8px;
    font-size: 18px;
    line-height: 1.45;
    opacity: 0.88;
  }

  .togetherList li {
    display: grid;
    grid-template-columns: 16px minmax(0, 1fr);
    gap: 10px;
  }

  .bullet {
    color: var(--color-deep-rose);
  }

  .upcoming {
    padding: 48px 48px 56px;
    background: var(--color-white);
    border-top: 1px solid var(--color-stone);
  }

  .upcomingInner {
    max-width: 900px;
    margin: 0 auto;
  }

  .upcomingIntro {
    text-align: center;
    margin-bottom: 36px;
  }

  .upcomingHeading {
    font-size: 42px;
    font-weight: 400;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    line-height: 1.2;
    margin: 0 0 14px;
    color: var(--color-heading);
  }

  .upcomingTag {
    margin: 0;
    font-size: 15px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--color-charcoal-light);
  }

  .eventRow {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 24px;
    align-items: baseline;
    padding: 26px 0;
    border-top: 1px solid var(--color-stone);
  }

  .eventName {
    font-family: var(--font-serif);
    font-weight: 700;
    font-size: 26px;
    line-height: 1.2;
    margin: 0 0 6px;
    color: var(--color-heading);
  }

  .eventDetail {
    margin: 0;
    font-size: 15px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--color-charcoal-light);
  }

  .eventDate {
    margin: 0;
    font-size: 19px;
    white-space: nowrap;
    opacity: 0.85;
  }

  .upcomingCta {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 18px;
    margin-top: 40px;
    text-align: center;
  }

  .upcomingCtaBody {
    margin: 0;
    font-size: 17px;
    line-height: 1.7;
    opacity: 0.82;
  }

  @media (max-width: 900px) {
    .momDadInner {
      grid-template-columns: 1fr;
    }

    .togetherGrid {
      grid-template-columns: 1fr;
    }

    .eventRow {
      grid-template-columns: 1fr;
      gap: 6px;
    }
  }
</style>
