---
import Layout from '../layouts/Layout.astro';

const GOES_TO = [
  {
    accent: 'var(--color-amber)',
    title: 'Creative development',
    body: 'Writing and reviewing each lesson with physicians, educators, and theologians so the science and the teaching both hold up.',
  },
  {
    accent: 'var(--color-rose)',
    title: 'Filming',
    body: 'Producing thirteen videos across four lessons, at a quality young people will actually watch.',
  },
  {
    accent: 'var(--color-sage)',
    title: 'Guides',
    body: 'Educator and parent guides, so the same formation reaches the classroom and the kitchen table.',
  },
];
---

<Layout
  title="Donate"
  description="Support Blessed Are They — fund Phase I of the curriculum, grades 4–5."
  active="donate"
>
  <section class="hero">
    <div class="heroInner">
      <p class="heroEyebrow">Support</p>
      <img class="heroWordmark" src="/uploads/slogan1-cream.png" alt="blessed are they" />
      <p class="heroBody">
        Phase I covers grades 4 and 5: four lessons, thirteen videos, and the
        educator and parent guides that go with them.
      </p>
    </div>
  </section>

  <section class="story">
    <div class="storyInner">
      <span class="rule" />
      <h2 class="storyHeading">Planted, Watered, Growth</h2>
      <div class="storyBody">
        <p>
          Kirsten has told this story for years: the Chinese bamboo tree.
          Plant it, water it, tend it — and for years, nothing. No visible
          growth at all. But underground, the whole time, it is building a
          root system wide enough and strong enough to hold what comes
          next. Then, almost overnight, it grows eighty feet in six weeks.
        </p>
        <p>
          Right now, Blessed Are They is underground. The incorporation.
          The 1023 filing. Three founders building a curriculum that does
          not exist anywhere else in the Church. We are doing this
          grassroots — one live event at a time, in one school hall and one
          parish hall at a time, meeting families where they already are.
          You cannot see most of it yet. But the roots are going in.
        </p>
        <p>Scripture tells us:</p>
        <p class="quote">
          &ldquo;I planted, Apollos watered, but God caused the
          growth.&rdquo;<br />
          <span class="quoteCite">1 Corinthians 3:6</span>
        </p>
        <p>
          We are planting. Your gift is the water. The growth — the eighty
          feet in six weeks — that is not ours to author. That is
          God&rsquo;s, in His time.
        </p>
      </div>
      <p class="storyClose">
        Fund Phase I. Help us water what is already growing underground.
      </p>
    </div>
  </section>

  <section class="give">
    <div class="giveInner">
      <p class="giveLede">
        Gifts fund creative development, filming, and the guides that put
        this curriculum in a classroom, a parish hall, and a home at the
        same time.
      </p>
      <div class="progress">
        <div class="progressRow">
          <span>Phase I, grades 4–5</span>
          <span>Estimated cost $149,000</span>
        </div>
        <div class="progressTrack">
          <div class="progressFill" />
        </div>
      </div>
      <a href="#" class="button button--large">Give now</a>
      <p class="giveNote">
        Blessed Are They is a 501(c)(3); gifts are tax-deductible.
      </p>
    </div>
  </section>

  <section class="goesTo">
    <div class="goesToInner">
      <h2 class="goesToHeading">Where your gift goes</h2>
      <div class="goesToGrid">
        {GOES_TO.map((g) => (
          <div class="goesToCard" style={{ '--accent': g.accent }}>
            <p class="goesToTitle">{g.title}</p>
            <p class="goesToBody">{g.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="otherWays">
    <div class="otherWaysInner">
      <h2 class="otherWaysHeading">Other ways to give</h2>
      <p class="otherWaysBody">
        For gifts by check, donor-advised funds, employer matching, or to
        discuss underwriting a full grade level, please get in touch.
      </p>
      <div class="otherWaysLinks">
        <a href="mailto:hello@blessedarethey.com" class="otherWaysLink">
          hello@blessedarethey.com &rarr;
        </a>
        <a
          href="https://venmo.com/u/Blessedarethey"
          target="_blank"
          rel="noopener"
          class="otherWaysLink"
        >
          Give via Venmo (@Blessedarethey) &rarr;
        </a>
      </div>
    </div>
  </section>
</Layout>

<style>
  .hero {
    padding: 88px 48px 76px;
    background: var(--color-charcoal-light);
    border-bottom: 1px solid #3a3a42;
  }

  .heroInner {
    max-width: 920px;
    margin: 0 auto;
    text-align: center;
  }

  .heroEyebrow {
    margin: 0 0 22px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--color-stone);
  }

  .heroWordmark {
    width: 100%;
    max-width: 520px;
    height: auto;
    display: block;
    margin: 0 auto 24px;
  }

  .heroBody {
    font-size: 20px;
    line-height: 1.65;
    opacity: 0.88;
    margin: 0 auto;
    max-width: 660px;
    color: var(--color-stone);
    text-wrap: pretty;
  }

  .story {
    padding: 72px 48px 76px;
    background: var(--color-stone);
    border-bottom: 1px solid #d8b9ab;
  }

  .storyInner {
    max-width: 760px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 26px;
  }

  .storyHeading {
    font-size: 34px;
    font-weight: 400;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    line-height: 1.25;
    margin: 0;
    color: var(--color-heading);
  }

  .storyBody {
    display: flex;
    flex-direction: column;
    gap: 20px;
    font-size: 18px;
    line-height: 1.72;
    color: var(--color-charcoal);
    text-align: left;
    text-wrap: pretty;
  }

  .storyBody p {
    margin: 0;
  }

  .quote {
    padding-left: 22px;
    border-left: 2px solid var(--color-amber);
    font-family: var(--font-serif);
    font-size: 22px;
    line-height: 1.45;
    color: var(--color-heading);
  }

  .quoteCite {
    font-family: var(--font-body);
    font-size: 14px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    opacity: 0.7;
  }

  .storyClose {
    font-family: var(--font-serif);
    font-size: 24px;
    line-height: 1.35;
    margin: 0;
    color: var(--color-heading);
    max-width: 620px;
    text-wrap: pretty;
  }

  .give {
    padding: 80px 48px 92px;
    background: var(--color-white);
  }

  .giveInner {
    max-width: 820px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  .giveLede {
    font-size: 19px;
    line-height: 1.68;
    opacity: 0.85;
    margin: 0 0 40px;
    text-wrap: pretty;
  }

  .progress {
    width: 100%;
    max-width: 520px;
    margin-bottom: 40px;
  }

  .progressRow {
    display: flex;
    justify-content: space-between;
    font-size: 14px;
    margin-bottom: 10px;
    opacity: 0.8;
  }

  .progressTrack {
    height: 8px;
    background: var(--color-stone);
    border-radius: 999px;
    overflow: hidden;
  }

  .progressFill {
    width: 22%;
    height: 100%;
    background: var(--color-sage);
  }

  .giveNote {
    margin: 20px 0 0;
    font-size: 14px;
    opacity: 0.72;
  }

  .goesTo {
    padding: 88px 48px 96px;
    background: var(--color-cream);
    border-top: 1px solid var(--color-stone);
  }

  .goesToInner {
    max-width: 1180px;
    margin: 0 auto;
  }

  .goesToHeading {
    font-family: 'Sorts Mill Goudy', Georgia, serif;
    font-weight: 400;
    font-size: 42px;
    line-height: 1.15;
    margin: 0 0 44px;
    text-align: center;
    color: var(--color-heading);
  }

  .goesToGrid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 32px;
  }

  .goesToCard {
    padding-top: 26px;
    border-top: 2px solid var(--accent, var(--color-amber));
  }

  .goesToTitle {
    font-family: 'Sorts Mill Goudy', Georgia, serif;
    font-size: 30px;
    margin: 0 0 10px;
    color: var(--color-charcoal);
  }

  .goesToBody {
    font-size: 16px;
    line-height: 1.7;
    opacity: 0.82;
    margin: 0;
    text-wrap: pretty;
  }

  .otherWays {
    padding: 80px 48px 96px;
    background: var(--color-white);
    border-top: 1px solid var(--color-stone);
  }

  .otherWaysInner {
    max-width: 760px;
    margin: 0 auto;
    text-align: center;
  }

  .otherWaysHeading {
    font-family: 'Sorts Mill Goudy', Georgia, serif;
    font-weight: 400;
    font-size: 36px;
    line-height: 1.18;
    margin: 0 0 18px;
    text-wrap: pretty;
    color: var(--color-charcoal);
  }

  .otherWaysBody {
    font-size: 17px;
    line-height: 1.7;
    opacity: 0.82;
    margin: 0 0 28px;
    text-wrap: pretty;
  }

  .otherWaysLinks {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 12px 28px;
  }

  .otherWaysLink {
    font-size: 16px;
  }

  @media (max-width: 900px) {
    .goesToGrid {
      grid-template-columns: 1fr;
    }
  }
</style>
