---
import Layout from '../layouts/Layout.astro';

const GOES_TO = [
  {
    accent: 'var(--color-amber)',
    title: 'Creative development',
    body: 'Writing and reviewing each lesson with physicians, educators, and theologians so the science and the teaching both hold up.',
  },
  {
    accent: 'var(--color-rose)',
    title: 'Filming',
    body: 'Producing thirteen videos across four lessons, at a quality young people will actually watch.',
  },
  {
    accent: 'var(--color-sage)',
    title: 'Guides',
    body: 'Educator and parent guides, so the same formation reaches the classroom and the kitchen table.',
  },
];
---

<Layout
  title="Donate"
  description="Support Blessed Are They — fund Phase I of the curriculum, grades 4–5."
  active="donate"
>
  <section class="hero">
    <div class="heroInner">
      <p class="heroEyebrow">Support</p>
      <span class="heroWordmarkWrap">
        <img class="heroWordmark" src="/uploads/slogan1-cream.png" alt="blessed are they" />
        <span class="heroTrademark">™</span>
      </span>
    </div>
  </section>

  <section class="give">
    <div class="giveInner">
      <p class="giveLede">
        Phase I covers grades 4 and 5: four lessons, thirteen videos, and the
        educator and parent guides that go with them.
      </p>
      <div class="progress">
        <div class="progressRow">
          <span>Phase I, grades 4–5</span>
          <span>Estimated cost $149,000</span>
        </div>
        <div class="progressTrack">
          <div class="progressFill" />
        </div>
      </div>
      <a
        href="https://givebutter.com/fund-health-education-for-500-students-2bki0x"
        class="button button--large"
        target="_blank"
        rel="noopener"
      >
        Give now
      </a>
      <p class="giveNote">
        Blessed Are They is a 501(c)(3); gifts are tax-deductible.
      </p>

      <div class="qrRow">
        <div class="qrCard">
          <div class="qrImgWrap">
            <img src="/uploads/venmo-qr.png" alt="Venmo QR code for Blessed Are They" />
          </div>
          <p class="qrLabel">Venmo</p>
          <p class="qrHandle">@Blessedarethey</p>
        </div>
        <div class="qrCard">
          <div class="qrImgWrap">
            <img src="/uploads/zelle-qr.png" alt="Zelle QR code for Blessed Are They" />
          </div>
          <p class="qrLabel">Zelle</p>
          <p class="qrHandle">info@blessedarethey.com</p>
        </div>
      </div>

      <p class="giveContact">
        For gifts by check, donor-advised funds, employer matching, or to
        discuss underwriting a full grade level, please get in touch:{' '}
        <a href="mailto:hello@blessedarethey.com">hello@blessedarethey.com</a>
      </p>
    </div>
  </section>

  <section class="story">
    <div class="storyInner">
      <span class="rule" />
      <h2 class="storyHeading">Planted, Watered, Growth</h2>
      <div class="storyBody">
        <p>
          Kirsten has told this story for years: the Chinese bamboo tree.
          Plant the seeds, water them, tend them daily — and for at least 5
          years, nothing. No visible growth at all. But underground, the
          whole time, it is building a root system wide enough and strong
          enough to hold what comes next and can sustain almost anything.
          Then, almost overnight, it grows eighty feet in six weeks.
        </p>
        <p>
          Right now, Blessed Are They is underground. The incorporation.
          The 1023 filing. Three founders building a curriculum that does
          not exist anywhere else in the Church. We are doing this
          grassroots — one conversation, one live event, one ask at a time.
          You cannot see most of it yet. But the roots are growing
          strong&hellip; and fast.
        </p>
        <p>Scripture tells us:</p>
        <p class="quote">
          &ldquo;I planted, Apollos watered, but God caused the
          growth.&rdquo;<br />
          <span class="quoteCite">1 Corinthians 3:6</span>
        </p>
        <p>
          We are planting. Your gift is the water. The growth — the eighty
          feet in six weeks — that is not ours to author. That is
          God&rsquo;s, in His time. But we are here for it.
        </p>
      </div>
      <p class="storyClose">
        Fund Phase I. Help us water what is already growing underground.
      </p>
    </div>
  </section>

  <section class="goesTo">
    <div class="goesToInner">
      <h2 class="goesToHeading">Where your gift goes</h2>
      <div class="goesToGrid">
        {GOES_TO.map((g) => (
          <div class="goesToCard" style={{ '--accent': g.accent }}>
            <p class="goesToTitle">{g.title}</p>
            <p class="goesToBody">{g.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>
</Layout>

<style>
  .hero {
    padding: 24px 48px 22px;
    background: var(--color-charcoal-light);
    border-bottom: 1px solid #3a3a42;
  }

  .heroInner {
    max-width: 920px;
    margin: 0 auto;
    text-align: center;
  }

  .heroEyebrow {
    margin: 0 0 14px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--color-stone);
  }

  .heroWordmarkWrap {
    position: relative;
    display: inline-block;
    width: 100%;
    max-width: 420px;
  }

  .heroWordmark {
    width: 100%;
    height: auto;
    display: block;
  }

  .heroTrademark {
    position: absolute;
    right: 13px;
    top: 29px;
    font-size: 13px;
    letter-spacing: 0.04em;
    color: var(--color-cream);
    opacity: 0.75;
  }

  .give {
    padding: 44px 48px 48px;
    background: var(--color-stone);
  }

  .giveInner {
    max-width: 820px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  .giveLede {
    font-size: 19px;
    line-height: 1.68;
    opacity: 0.85;
    font-weight: 700;
    margin: 0 0 26px;
    text-wrap: pretty;
  }

  .progress {
    width: 100%;
    max-width: 520px;
    margin-bottom: 26px;
  }

  .progressRow {
    display: flex;
    justify-content: space-between;
    font-size: 14px;
    margin-bottom: 10px;
    opacity: 0.8;
  }

  .progressTrack {
    height: 8px;
    background: var(--color-cream);
    border-radius: 999px;
    overflow: hidden;
  }

  .progressFill {
    width: 22%;
    height: 100%;
    background: var(--color-sage);
  }

  .giveNote {
    margin: 16px 0 0;
    font-size: 14px;
    opacity: 0.72;
  }

  .qrRow {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 48px 180px;
    margin: 32px 0 0;
  }

  .qrCard {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 10px;
  }

  .qrImgWrap {
    width: 150px;
    height: 150px;
    border: 1px solid var(--color-stone);
    border-radius: 12px;
    overflow: hidden;
    background: var(--color-cream);
    padding: 8px;
    box-sizing: border-box;
  }

  .qrImgWrap img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    display: block;
  }

  .qrLabel {
    margin: 0;
    font-size: 13px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    opacity: 0.75;
  }

  .qrHandle {
    margin: 0;
    font-size: 13px;
    opacity: 0.75;
  }

  .giveContact {
    margin: 12px 0 0;
    font-size: 16px;
    line-height: 1.65;
    opacity: 0.78;
    text-wrap: pretty;
  }

  .story {
    padding: 72px 48px 76px;
    background: var(--color-white);
    border-bottom: 1px solid var(--color-stone);
  }

  .storyInner {
    max-width: 760px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 26px;
  }

  .storyHeading {
    font-size: 34px;
    font-weight: 400;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    line-height: 1.25;
    margin: 0;
    color: var(--color-heading);
  }

  .storyBody {
    display: flex;
    flex-direction: column;
    gap: 20px;
    font-size: 18px;
    line-height: 1.72;
    color: var(--color-charcoal);
    text-align: left;
    text-wrap: pretty;
  }

  .storyBody p {
    margin: 0;
  }

  .quote {
    padding-left: 22px;
    border-left: 2px solid var(--color-amber);
    font-family: var(--font-serif);
    font-size: 22px;
    line-height: 1.45;
    color: var(--color-heading);
  }

  .quoteCite {
    font-family: var(--font-body);
    font-size: 14px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    opacity: 0.7;
  }

  .storyClose {
    font-family: var(--font-serif);
    font-size: 24px;
    line-height: 1.35;
    margin: 0;
    color: var(--color-heading);
    max-width: 620px;
    text-wrap: pretty;
  }

  .goesTo {
    padding: 88px 48px 96px;
    background: var(--color-cream);
    border-top: 1px solid var(--color-stone);
  }

  .goesToInner {
    max-width: 1180px;
    margin: 0 auto;
  }

  .goesToHeading {
    font-family: 'Sorts Mill Goudy', Georgia, serif;
    font-weight: 400;
    font-size: 42px;
    line-height: 1.15;
    margin: 0 0 44px;
    text-align: center;
    color: var(--color-heading);
  }

  .goesToGrid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 32px;
  }

  .goesToCard {
    padding-top: 26px;
    border-top: 2px solid var(--accent, var(--color-amber));
  }

  .goesToTitle {
    font-family: 'Sorts Mill Goudy', Georgia, serif;
    font-size: 30px;
    margin: 0 0 10px;
    color: var(--color-charcoal);
  }

  .goesToBody {
    font-size: 16px;
    line-height: 1.7;
    opacity: 0.82;
    margin: 0;
    text-wrap: pretty;
  }

  @media (max-width: 900px) {
    .goesToGrid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 640px) {
    .qrRow {
      gap: 32px;
    }
  }
</style>
