---
import Layout from '../layouts/Layout.astro';
import {
  getResourceSections,
  getChurchDocuments,
  resourceLabel,
  LIFE_STAGES,
  type ResourceSection,
  type ChurchDocument,
} from '../lib/sanity';

// Sections and their items come from Sanity ("Resource section" and
// "Resource" in the Studio) so staff can add, retag, or reorder them
// without a code change. Sorting within a section (by life stage, then
// the optional sort order) happens in getResourceSections().
let sections: ResourceSection[] = [];
let loadFailed = false;
try {
  sections = await getResourceSections();
} catch {
  loadFailed = true;
}

const STAGES = ['All', ...LIFE_STAGES];

// "What This Rests On" entries — "Church document" in the Studio.
let churchDocs: ChurchDocument[] = [];
let churchDocsFailed = false;
try {
  churchDocs = await getChurchDocuments();
} catch {
  churchDocsFailed = true;
}
---

<Layout
  title="Resources"
  description="The Blessed Are They Library — a growing collection of medically accurate, Theology of the Body–rooted resources."
  active="resources"
>
  <section class="hero">
    <h1 class="heroTitle">Resources</h1>
  </section>

  <section class="libraryIntro">
    <div class="libraryIntroInner">
      <div>
        <div class="eyebrowRow">
          <span class="eyebrowRule" />
          <p class="eyebrowSm">Nothing Under a Bushel Basket</p>
        </div>
        <h2 class="libraryHeading">
          The Blessed Are They <span class="libraryHeadingScript">Library</span>
        </h2>
        <p class="libraryLede">
          A growing collection of what we have made and what we trust.<br />
          Everything here is medically accurate &amp; rooted in the Theology
          of the Body.
        </p>
        <p class="libraryApproved">
          <span class="script">blessed</span>{' '}
          <span class="sans">ARE THEY</span> approved.
        </p>
      </div>
      <div class="basketRow">
        <svg
          viewBox="0 0 152 122"
          width="128"
          height="103"
          fill="none"
          stroke="#3A3A42"
          stroke-width="3"
          stroke-linecap="round"
          stroke-linejoin="round"
          role="img"
          aria-label="Bushel basket"
          class="basketSvg"
        >
          <path d="M20 36c0 8 25 15 56 15s56-7 56-15"></path>
          <path d="M20 36c0-8 25-15 56-15s56 7 56 15"></path>
          <path d="M28 40c0 6 21 11 48 11s48-5 48-11"></path>
          <path d="M52 25v18"></path>
          <path d="M76 22v22"></path>
          <path d="M100 25v18"></path>
          <path d="M23 43l10 62c1 6 20 11 43 11s42-5 43-11l10-62"></path>
          <path d="M27 66c11 5 30 8 49 8s38-3 49-8"></path>
          <path d="M31 92c10 4 27 7 45 7s35-3 45-7"></path>
          <path d="M42 53l6 60"></path>
          <path d="M59 57l3 58"></path>
          <path d="M93 57l-3 58"></path>
          <path d="M110 53l-6 60"></path>
          <path d="M76 58v58"></path>
          <path d="M23 41 12 33l3-12 8 2"></path>
          <path d="M129 41l11-8-3-12-8 2"></path>
        </svg>
        <p class="quote">
          &ldquo;Nor do they light a lamp and then put it under a bushel
          basket; it is set on a lampstand, where it gives light to all in
          the house.&rdquo;<br />
          <span class="quoteCite">Matthew 5:15</span>
        </p>
      </div>
    </div>
  </section>

  <section class="library">
    <div class="libraryInner">
      <div class="filterRow" role="group" aria-label="Filter by life stage">
        <p class="filterLabel">Filter by life stage</p>
        {STAGES.map((stage, i) => (
          <button
            type="button"
            class="stageBtn"
            data-stage={stage}
            aria-pressed={i === 0 ? 'true' : 'false'}
          >
            {stage}
          </button>
        ))}
      </div>

      {loadFailed ? (
        <p class="loadError">
          Couldn&rsquo;t load the library right now &mdash; try again shortly.
        </p>
      ) : (
        <div class="shelfGrid" id="shelfGrid">
          {sections.map((shelf) => (
            <div class="shelf">
              <h3 class="shelfTitle">{shelf.title}</h3>
              {shelf.blurb && <p class="shelfBlurb">{shelf.blurb}</p>}
              {shelf.items.map((item) => {
                const tags = item.lifeStages || [];
                const href = item.fileUrl || item.externalUrl;
                return (
                  <div class="item" data-tags={tags.join(',')}>
                    <div class="itemMetaRow">
                      <p class="itemStage" data-first-tag={tags[0] || ''}>
                        {tags[0] || 'All stages'}
                      </p>
                      <p class="itemMeta">{resourceLabel(item)}</p>
                    </div>
                    <h4 class="itemTitle">{item.title}</h4>
                    {href && (
                      <a href={href} target="_blank" class="itemLink" rel="noopener">
                        {item.fileUrl ? 'Download PDF' : 'View resource'}
                      </a>
                    )}
                    {item.description && <p class="itemDesc">{item.description}</p>}
                  </div>
                );
              })}
            </div>
          ))}
        </div>
      )}
    </div>
  </section>

  <section class="restsOn">
    <div class="restsOnInner">
      <div class="restsOnGrid">
        <div>
          <h3 class="restsOnTitle">What This Rests On</h3>
          <p class="restsOnBlurb">
            We did not invent this teaching. These are the documents it comes
            from — read them yourself.
          </p>
        </div>
        {churchDocsFailed ? (
          <p class="loadError">
            Couldn&rsquo;t load these documents right now &mdash; try again
            shortly.
          </p>
        ) : (
          <div class="docsGrid">
            {churchDocs.map((doc) => (
              <div class="doc">
                {doc.meta && <p class="docMeta">{doc.meta}</p>}
                <h4 class="docTitle">{doc.title}</h4>
                <a href={doc.url} target="_blank" rel="noopener" class="itemLink">
                  {doc.linkLabel || 'Read at Vatican.va'}
                </a>
                {doc.description && (
                  <p class:list={['itemDesc', { catechismDesc: doc.passages?.length }]}>
                    {doc.description}
                  </p>
                )}
                {doc.passages?.length ? (
                  <div class="catechismLinks">
                    {doc.passages.map((passage) => (
                      <a href={passage.url} target="_blank" rel="noopener">
                        {passage.label}
                      </a>
                    ))}
                  </div>
                ) : null}
              </div>
            ))}
          </div>
        )}
      </div>
    </div>
  </section>

  <section class="educatorBanner">
    <div class="educatorBannerInner">
      <p class="educatorBannerBody">
        Teaching this at home, in a classroom, or in a parish? Lesson plans,
        discussion guides, and parish materials are kept in the Educator
        Portal.
      </p>
      <a href="/educator-portal" class="outlineButton">Educator Portal</a>
    </div>
  </section>

  <section class="filling">
    <div class="fillingInner">
      <span class="rule" />
      <h2 class="fillingHeading">The Shelves Are Filling</h2>
      <p class="fillingBody">
        The library grows as we write and as we find work worth passing on.
        Tell us what you are looking for and we will put it on the list.
      </p>
      <a class="button" href="mailto:hello@blessedarethey.com?subject=For%20the%20library">
        Request a Resource
      </a>
    </div>
  </section>
</Layout>

<script>
  // Progressive-enhancement filter: everything above renders with all
  // shelves/items visible (so it's a real page with no JS too) — this
  // just narrows what's shown. Items with no life stages ticked are
  // "All stages" and show under every filter.
  const buttons = Array.from(
    document.querySelectorAll<HTMLButtonElement>('.stageBtn')
  );
  const shelves = Array.from(
    document.querySelectorAll<HTMLElement>('.shelf')
  );
  const grid = document.getElementById('shelfGrid');

  function applyFilter(stage: string) {
    let visibleShelves = 0;

    shelves.forEach((shelf) => {
      let visibleItems = 0;
      shelf.querySelectorAll<HTMLElement>('.item').forEach((item) => {
        const tags = item.dataset.tags ? item.dataset.tags.split(',') : [];
        const visible = stage === 'All' || tags.length === 0 || tags.includes(stage);
        item.classList.toggle('item--hidden', !visible);
        if (visible) {
          visibleItems++;
          const badge = item.querySelector<HTMLElement>('.itemStage');
          if (badge) {
            badge.textContent =
              tags.length === 0 ? 'All stages' : stage === 'All' ? tags[0] : stage;
          }
        }
      });

      const showShelf = visibleItems > 0;
      shelf.classList.toggle('shelf--hidden', !showShelf);
      if (showShelf) visibleShelves++;
    });

    if (grid) {
      if (visibleShelves <= 2) {
        grid.style.gridTemplateColumns = `repeat(${Math.max(visibleShelves, 1)}, minmax(0, 1fr))`;
        grid.style.maxWidth = '760px';
      } else {
        grid.style.gridTemplateColumns = 'repeat(auto-fit, minmax(238px, 1fr))';
        grid.style.maxWidth = 'none';
      }
    }
  }

  buttons.forEach((btn) => {
    btn.addEventListener('click', () => {
      buttons.forEach((b) => b.setAttribute('aria-pressed', String(b === btn)));
      applyFilter(btn.dataset.stage || 'All');
    });
  });
</script>

<style>
  .hero {
    padding: 40px var(--gutter) 44px;
    background: var(--color-charcoal-light);
  }

  .heroTitle {
    max-width: 920px;
    margin: 0 auto;
    text-align: center;
    font-family: var(--font-serif);
    font-weight: 700;
    font-size: clamp(29px, 6.57vw, 46px);
    line-height: 1.15;
    color: var(--color-cream);
  }

  .libraryIntro {
    padding: 60px var(--gutter) 64px;
    background: var(--color-stone);
    border-bottom: 1px solid #d8b9ab;
  }

  .libraryIntroInner {
    max-width: 1180px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: minmax(0, 1.35fr) minmax(0, 1fr);
    align-items: center;
    gap: 64px;
  }

  .eyebrowRow {
    display: flex;
    align-items: center;
    gap: 16px;
    margin-bottom: 18px;
  }

  .eyebrowRule {
    display: block;
    width: 38px;
    height: 2px;
    background: var(--color-amber);
  }

  .eyebrowSm {
    margin: 0;
    font-size: 14px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--color-charcoal-light);
  }

  .libraryHeading {
    font-size: clamp(24px, 5.43vw, 38px);
    font-weight: 400;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    line-height: 1.14;
    margin: 0 0 22px;
    color: var(--color-heading);
  }

  .libraryHeadingScript {
    font-family: var(--font-serif);
    font-weight: 700;
    font-size: clamp(35px, 8.0vw, 56px);
    letter-spacing: 0.02em;
    text-transform: lowercase;
  }

  .libraryLede {
    font-size: 20px;
    line-height: 1.6;
    opacity: 0.85;
    margin: 0 0 18px;
    text-wrap: pretty;
  }

  .libraryApproved {
    margin: 0;
    font-size: 17px;
    letter-spacing: 0.04em;
    color: var(--color-heading);
  }

  .libraryApproved .script {
    font-family: var(--font-serif);
  }

  .libraryApproved .sans {
    font-family: 'Montserrat', system-ui, sans-serif;
    font-weight: 700;
    text-transform: uppercase;
  }

  .loadError {
    margin: 32px 0 0;
    text-align: center;
    font-size: 16px;
    opacity: 0.75;
  }

  .basketRow {
    display: flex;
    align-items: center;
    gap: 26px;
  }

  .basketSvg {
    display: block;
    flex: none;
    opacity: 0.9;
  }

  .quote {
    margin: 0;
    padding-left: 22px;
    border-left: 2px solid var(--color-amber);
    font-family: var(--font-serif);
    font-size: 18px;
    line-height: 1.5;
    color: var(--color-heading);
    text-wrap: pretty;
  }

  .quoteCite {
    font-family: var(--font-body);
    font-size: 12px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    opacity: 0.7;
  }

  .library {
    padding: 60px var(--gutter) 88px;
    background: var(--color-white);
  }

  .libraryInner {
    max-width: 1660px;
    margin: 0 auto;
  }

  .filterRow {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 10px;
    padding-bottom: 24px;
    border-bottom: 1px solid var(--color-stone);
    margin-bottom: 30px;
  }

  .filterLabel {
    margin: 0 12px 0 0;
    font-size: 11px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    opacity: 0.55;
  }

  .stageBtn {
    padding: 7px 15px;
    border-radius: 999px;
    border: 1px solid var(--color-stone);
    background: transparent;
    color: var(--color-heading);
    font: inherit;
    font-size: 12px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    cursor: pointer;
  }

  .stageBtn:hover {
    border-color: var(--color-deep-rose);
    color: var(--color-deep-rose);
  }

  .stageBtn[aria-pressed='true'] {
    border-color: var(--color-deep-rose);
    background: var(--color-deep-rose);
    color: var(--color-white);
  }

  .shelfGrid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(238px, 1fr));
    column-gap: 36px;
    row-gap: 56px;
    align-items: start;
    margin: 0 auto;
  }

  .shelf {
    display: flex;
    flex-direction: column;
  }

  .shelf--hidden {
    display: none;
  }

  .shelfTitle {
    font-size: 21px;
    font-weight: 400;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    margin: 0 0 8px;
    color: var(--color-heading);
  }

  .shelfBlurb {
    margin: 0 0 20px;
    font-size: 14px;
    line-height: 1.6;
    opacity: 0.7;
    text-wrap: pretty;
  }

  .item {
    padding: 22px 0;
    border-top: 1px solid var(--color-stone);
  }

  .item--hidden {
    display: none;
  }

  .itemMetaRow {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 14px;
    margin-bottom: 6px;
  }

  .itemStage {
    margin: 0;
    font-family: ui-monospace, monospace;
    font-size: 11px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-deep-sage);
  }

  .itemMeta {
    margin: 0;
    font-size: 11px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    opacity: 0.55;
    white-space: nowrap;
  }

  .itemTitle {
    font-family: var(--font-serif);
    font-weight: 400;
    font-size: 20px;
    line-height: 1.3;
    margin: 0 0 6px;
    color: var(--color-heading);
  }

  .itemLink {
    display: inline-block;
    margin-bottom: 6px;
    font-size: 12px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-deep-rose);
  }

  .itemLink:hover {
    color: var(--color-charcoal);
  }

  .itemDesc {
    margin: 0;
    font-size: 15px;
    line-height: 1.6;
    opacity: 0.8;
    text-wrap: pretty;
  }

  .restsOn {
    padding: 8px var(--gutter) 72px;
    background: var(--color-white);
  }

  .restsOnInner {
    max-width: 1660px;
    margin: 0 auto;
    padding-top: 48px;
    border-top: 1px solid var(--color-stone);
  }

  .restsOnGrid {
    display: grid;
    grid-template-columns: minmax(220px, 320px) minmax(0, 1fr);
    column-gap: 64px;
    row-gap: 28px;
    align-items: start;
  }

  .restsOnTitle {
    font-size: 21px;
    font-weight: 400;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    margin: 0 0 10px;
    color: var(--color-heading);
  }

  .restsOnBlurb {
    margin: 0;
    font-size: 14px;
    line-height: 1.6;
    opacity: 0.7;
    text-wrap: pretty;
  }

  .docsGrid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    column-gap: 36px;
    row-gap: 4px;
  }

  .doc {
    padding: 20px 0;
    border-top: 1px solid var(--color-stone);
  }

  .docMeta {
    margin: 0 0 6px;
    font-family: ui-monospace, monospace;
    font-size: 11px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-deep-sage);
  }

  .docTitle {
    font-family: var(--font-serif);
    font-weight: 400;
    font-size: 19px;
    line-height: 1.3;
    margin: 0 0 6px;
    color: var(--color-heading);
  }

  .catechismDesc {
    margin: 0 0 10px;
  }

  .catechismLinks {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .catechismLinks a {
    font-size: 12px;
    letter-spacing: 0.06em;
    color: var(--color-deep-rose);
  }

  .catechismLinks a:hover {
    color: var(--color-charcoal);
  }

  .educatorBanner {
    padding: 0 var(--gutter) 76px;
    background: var(--color-white);
  }

  .educatorBannerInner {
    max-width: 1660px;
    margin: 0 auto;
    padding: 26px 30px;
    border: 1px solid var(--color-stone);
    border-radius: 3px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 18px;
  }

  .educatorBannerBody {
    margin: 0;
    font-size: 16px;
    line-height: 1.6;
    opacity: 0.85;
    max-width: 640px;
    text-wrap: pretty;
  }

  .outlineButton {
    flex: none;
    display: inline-block;
    padding: 12px 26px;
    border: 1px solid var(--color-deep-rose);
    border-radius: 999px;
    color: var(--color-deep-rose);
    font-size: 13px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .outlineButton:hover {
    background: var(--color-deep-rose);
    color: var(--color-white);
  }

  .filling {
    padding: 52px var(--gutter) 60px;
    background: var(--color-cream);
    border-top: 1px solid var(--color-stone);
  }

  .fillingInner {
    max-width: 720px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 16px;
    text-align: center;
  }

  .fillingHeading {
    font-size: clamp(22px, 4.29vw, 30px);
    font-weight: 400;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    line-height: 1.25;
    margin: 0;
    color: var(--color-heading);
  }

  .fillingBody {
    font-size: 18px;
    line-height: 1.7;
    opacity: 0.85;
    margin: 0;
    max-width: 580px;
    text-wrap: pretty;
  }

  @media (max-width: 900px) {
    .libraryIntroInner {
      grid-template-columns: 1fr;
    }

    .restsOnGrid {
      grid-template-columns: 1fr;
    }
  }

  /* Phone: basket above the verse instead of squeezing the verse into a
     narrow column beside it. */
  @media (max-width: 560px) {
    .basketRow {
      flex-direction: column;
      align-items: flex-start;
      gap: 20px;
    }
  }
</style>
