    font-size: 14px;
    line-height: 1.6;
    opacity: 0.7;
    text-wrap: pretty;
  }

  .item {
    padding: 22px 0;
    border-top: 1px solid var(--color-stone);
  }

  .item--hidden {
    display: none;
  }

  .itemMetaRow {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 14px;
    margin-bottom: 6px;
  }

  .itemStage {
    margin: 0;
    font-family: ui-monospace, monospace;
    font-size: 11px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-deep-sage);
  }

  .itemMeta {
    margin: 0;
    font-size: 11px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    opacity: 0.55;
    white-space: nowrap;
  }

  .itemTitle {
    font-family: var(--font-serif);
    font-weight: 400;
    font-size: 20px;
    line-height: 1.3;
    margin: 0 0 6px;
    color: var(--color-heading);
  }

  .itemLink {
    display: inline-block;
    margin-bottom: 6px;
    font-size: 12px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-deep-rose);
  }

  .itemLink:hover {
    color: var(--color-charcoal);
  }

  .itemDesc {
    margin: 0;
    font-size: 15px;
    line-height: 1.6;
    opacity: 0.8;
    text-wrap: pretty;
  }

  .restsOn {
    padding: 8px 48px 72px;
    background: var(--color-white);
  }

  .restsOnInner {
