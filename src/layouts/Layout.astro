---
import '../styles/global.css';
import { NAV_ITEMS, DONATE_HREF, type NavKey } from '../lib/nav';
import SiteFooter from '../components/SiteFooter.astro';
import { SITE_DESCRIPTION } from '../lib/site';

interface Props {
  title: string;
  description?: string;
  active?: NavKey;
  /** Replaces the whole "<title> | Blessed Are They" pattern — used by the
   *  homepage, where the brand should lead instead of "Home". */
  fullTitle?: string;
  /** Social-share (Open Graph/Twitter card) image, absolute or root-relative.
   *  Defaults to the 1200x630 site card. */
  image?: string;
  /** 'article' for blog posts (adds published time for link previews). */
  type?: 'website' | 'article';
  publishedAt?: string;
  /** Extra schema.org JSON-LD for this page (BlogPosting, PodcastEpisode…),
   *  added alongside the site-wide Organization block. */
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
}

const {
  title,
  description = SITE_DESCRIPTION,
  active,
  fullTitle,
  image = '/og-image.jpg',
  type = 'website',
  publishedAt,
  jsonLd,
} = Astro.props;

const pageTitle = fullTitle || `${title} | Blessed Are They`;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const socialImageURL = new URL(image, Astro.site);

// Google Analytics 4 measurement ID ("G-…", from GA → Admin → Data
// streams). Empty = analytics off. Only loads on the deployed site, so
// local previews and testing don't count as visits.
const GA_MEASUREMENT_ID = 'G-JNDCM9YMFR';
const loadAnalytics = import.meta.env.PROD && GA_MEASUREMENT_ID !== '';

// Tells search engines who runs the site (name, logo, contact, social
// profiles) — the basis for Google's knowledge panel.
const organizationLd = {
  '@context': 'https://schema.org',
  '@type': 'NGO',
  '@id': `${Astro.site}#organization`,
  name: 'Blessed Are They',
  url: Astro.site?.toString(),
  logo: new URL('/uploads/BATlogo.jpg', Astro.site).toString(),
  description: SITE_DESCRIPTION,
  email: 'hello@blessedarethey.com',
  nonprofitStatus: 'Nonprofit501c3',
  sameAs: [
    'https://www.instagram.com/blessedaretheyministry/',
    'https://www.facebook.com/profile.php?id=61587253109351',
  ],
};
const ldBlocks = [organizationLd, ...(jsonLd ? [jsonLd].flat() : [])];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="google-site-verification" content="aQvAkm0bYBMxvbsSyEtB9epE-fGCF8XvuQmMpI2dhgM" />
    <title>{pageTitle}</title>
    <link rel="canonical" href={canonicalURL} />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#4c4c58" />

    <meta property="og:type" content={type} />
    <meta property="og:site_name" content="Blessed Are They" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={socialImageURL} />
    {type === 'article' && publishedAt && (
      <meta property="article:published_time" content={publishedAt} />
    )}

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImageURL} />

    {ldBlocks.map((block) => (
      <script type="application/ld+json" set:html={JSON.stringify(block)} />
    ))}

    {loadAnalytics && (
      <>
        <script
          is:inline
          async
          src={`https://www.googletagmanager.com/gtag/js?id=${GA_MEASUREMENT_ID}`}
        ></script>
        {/* Google's standard snippet, written out as-is (not wrapped by
            define:vars) so gtag() stays global for any custom events. */}
        <script
          is:inline
          set:html={`window.dataLayer = window.dataLayer || [];
function gtag(){dataLayer.push(arguments);}
gtag('js', new Date());
gtag('config', '${GA_MEASUREMENT_ID}');`}
        />
      </>
    )}

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Sorts+Mill+Goudy:ital@0;1&family=Karla:ital,wght@0,300..700;1,400&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <div class="utility-bar">
      <span>Catholic Reproductive Health Education</span>
      <div class="utility-links">
        <a href="mailto:hello@blessedarethey.com">hello@blessedarethey.com</a>
        <!-- Login temporarily hidden at the user's request — restore this
             link when subscriber login is ready for visitors. -->
      </div>
    </div>

    <header class="site-header">
      <div class="site-header__inner">
        <a class="brand" href="/" aria-label="Blessed Are They — home">
          <img class="brand__logo" src="/uploads/BATlogo.jpg" alt="" />
          <img
            class="brand__wordmark"
            src="/uploads/slogan3.jpg"
            alt="Blessed Are They"
          />
        </a>

        <!-- Phone-width only: Donate stays visible and the page links
             collapse behind a menu button (see the max-width: 900px
             rules below). Hidden entirely on desktop. -->
        <div class="headerActions">
          <a href={DONATE_HREF} class="nav__donate">Donate</a>
          <button
            type="button"
            class="menuToggle"
            aria-expanded="false"
            aria-controls="site-nav"
            aria-label="Menu"
            data-menu-toggle
          >
            <span class="menuToggle__icon" aria-hidden="true"></span>
            <span class="menuToggle__label">Menu</span>
          </button>
        </div>

        <nav class="nav" id="site-nav" data-menu>
          {
            NAV_ITEMS.map((item) => (
              <a
                href={item.href}
                class="nav__link"
                aria-current={active === item.key ? 'page' : undefined}
              >
                {item.label}
              </a>
            ))
          }
          <a href={DONATE_HREF} class="nav__donate">
            Donate
          </a>
        </nav>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <SiteFooter />

    <script>
      const toggle = document.querySelector<HTMLButtonElement>('[data-menu-toggle]');
      const menu = document.querySelector<HTMLElement>('[data-menu]');
      if (toggle && menu) {
        const setOpen = (open: boolean) => {
          toggle.setAttribute('aria-expanded', String(open));
          menu.toggleAttribute('data-open', open);
        };
        toggle.addEventListener('click', () =>
          setOpen(toggle.getAttribute('aria-expanded') !== 'true')
        );
        // Close after picking a link (matters for same-page anchors like
        // /#newsletter, which don't trigger a page load) or on Escape.
        menu.addEventListener('click', (e) => {
          if ((e.target as HTMLElement).closest('a')) setOpen(false);
        });
        document.addEventListener('keydown', (e) => {
          if (e.key === 'Escape') setOpen(false);
        });
      }
    </script>

    <style>
      .utility-bar {
        background: var(--color-charcoal-light);
        color: var(--color-stone);
        padding: 9px var(--gutter);
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 24px;
        font-size: 15px;
        text-transform: uppercase;
        letter-spacing: 0.06em;
      }

      .utility-bar a {
        color: var(--color-stone);
      }

      .utility-bar a:hover {
        color: var(--color-white);
      }

      .utility-links {
        display: flex;
        gap: 26px;
        align-items: center;
      }

      .site-header {
        background: var(--color-cream);
        border-bottom: 1px solid var(--color-stone);
        position: sticky;
        top: 0;
        z-index: 20;
      }

      .site-header__inner {
        max-width: var(--content-max);
        margin: 0 auto;
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        justify-content: space-between;
        gap: 20px 28px;
        padding: 18px 40px;
      }

      .brand {
        display: flex;
        align-items: center;
        gap: 14px;
      }

      .brand img {
        display: block;
        mix-blend-mode: multiply;
      }

      .brand__logo {
        height: 50px;
        width: auto;
      }

      .brand__wordmark {
        height: 40px;
        width: auto;
      }

      .nav {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        justify-content: flex-end;
        gap: 10px 18px;
      }

      .nav__link {
        font-size: 14px;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        color: var(--color-charcoal);
      }

      .nav__link:hover,
      .nav__link[aria-current='page'] {
        color: var(--color-deep-rose);
      }

      .nav__donate {
        display: inline-block;
        padding: 9px 20px;
        background: var(--color-deep-rose);
        color: var(--color-white);
        border-radius: 999px;
        font-size: 14px;
        text-transform: uppercase;
        letter-spacing: 0.05em;
      }

      .nav__donate:hover {
        background: var(--color-deep-rose-hover);
        color: var(--color-white);
      }

      main {
        display: block;
      }

      .headerActions {
        display: none;
      }

      .menuToggle {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 8px 4px;
        background: none;
        border: none;
        font-family: var(--font-body);
        font-size: 14px;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        color: var(--color-charcoal);
        cursor: pointer;
      }

      /* Three-line icon that turns into an X when the menu is open. */
      .menuToggle__icon,
      .menuToggle__icon::before,
      .menuToggle__icon::after {
        display: block;
        width: 20px;
        height: 2px;
        background: currentColor;
        transition: transform 0.2s ease, background-color 0.2s ease;
      }

      .menuToggle__icon {
        position: relative;
      }

      .menuToggle__icon::before,
      .menuToggle__icon::after {
        content: '';
        position: absolute;
        left: 0;
      }

      .menuToggle__icon::before {
        top: -6px;
      }

      .menuToggle__icon::after {
        top: 6px;
      }

      .menuToggle[aria-expanded='true'] .menuToggle__icon {
        background: transparent;
      }

      .menuToggle[aria-expanded='true'] .menuToggle__icon::before {
        transform: translateY(6px) rotate(45deg);
      }

      .menuToggle[aria-expanded='true'] .menuToggle__icon::after {
        transform: translateY(-6px) rotate(-45deg);
      }

      @media (max-width: 900px) {
        .utility-bar {
          flex-direction: column;
          gap: 2px;
          padding: 7px var(--gutter);
          font-size: 11px;
          letter-spacing: 0.08em;
          text-align: center;
        }

        .site-header__inner {
          flex-wrap: nowrap;
          gap: 12px;
          padding: 12px var(--gutter);
        }

        .brand {
          gap: 10px;
          min-width: 0;
        }

        .brand__logo {
          height: 40px;
        }

        .brand__wordmark {
          height: 30px;
        }

        .headerActions {
          display: flex;
          align-items: center;
          gap: 14px;
          flex-shrink: 0;
        }

        .nav {
          display: none;
          position: absolute;
          top: 100%;
          left: 0;
          right: 0;
          flex-direction: column;
          align-items: stretch;
          gap: 0;
          padding: 4px var(--gutter) 12px;
          background: var(--color-cream);
          border-bottom: 1px solid var(--color-stone);
          box-shadow: 0 12px 24px rgba(47, 47, 56, 0.08);
        }

        .nav[data-open] {
          display: flex;
        }

        .nav__link {
          padding: 14px 0;
          font-size: 15px;
        }

        .nav__link + .nav__link {
          border-top: 1px solid var(--color-stone);
        }

        /* Donate already sits in the header row on phones. */
        .nav .nav__donate {
          display: none;
        }
      }

      /* Most phones: icon-only menu button so the wordmark has room. */
      @media (max-width: 440px) {
        .menuToggle__label {
          display: none;
        }

        .nav__donate {
          padding: 8px 16px;
          font-size: 13px;
        }
      }

      @media (max-width: 360px) {
        .brand__wordmark {
          height: 24px;
        }
      }
    </style>
  </body>
</html>
