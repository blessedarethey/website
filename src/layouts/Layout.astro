---
import '../styles/global.css';
import { NAV_ITEMS, DONATE_HREF, type NavKey } from '../lib/nav';
import HomeFooter from '../components/HomeFooter.astro';
import SiteFooter from '../components/SiteFooter.astro';

interface Props {
  title: string;
  description?: string;
  active?: NavKey;
  /** 'home' gets the Homepage's own cream footer; every other page gets
   *  the shared dark SiteFooter. Defaults to 'site' since most pages are
   *  not the homepage. */
  footer?: 'home' | 'site';
}

const {
  title,
  description = 'Blessed Are They',
  active,
  footer = 'site',
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <title>{title} | Blessed Are They</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Sorts+Mill+Goudy:ital@0;1&family=Karla:ital,wght@0,300..700;1,400&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <div class="utility-bar">
      <span>Catholic Reproductive Health Education</span>
      <div class="utility-links">
        <a href="mailto:hello@blessedarethey.com">hello@blessedarethey.com</a>
        <a href="#">Login</a>
      </div>
    </div>

    <header class="site-header">
      <div class="site-header__inner">
        <div class="brand">
          <img class="brand__logo" src="/uploads/BATlogo.jpg" alt="" />
          <img
            class="brand__wordmark"
            src="/uploads/slogan3.jpg"
            alt="Blessed Are They"
          />
        </div>

        <nav class="nav">
          {
            NAV_ITEMS.map((item) => (
              <a
                href={item.href}
                class="nav__link"
                aria-current={active === item.key ? 'page' : undefined}
              >
                {item.label}
              </a>
            ))
          }
          <a href={DONATE_HREF} class="nav__donate">
            Donate
          </a>
        </nav>
      </div>
    </header>

    <main>
      <slot />
    </main>

    {footer === 'home' ? <HomeFooter /> : <SiteFooter />}

    <style>
      .utility-bar {
        background: var(--color-charcoal-light);
        color: var(--color-stone);
        padding: 9px 48px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 24px;
        font-size: 15px;
        text-transform: uppercase;
        letter-spacing: 0.06em;
      }

      .utility-bar a {
        color: var(--color-stone);
      }

      .utility-bar a:hover {
        color: var(--color-white);
      }

      .utility-links {
        display: flex;
        gap: 26px;
        align-items: center;
      }

      .site-header {
        background: var(--color-cream);
        border-bottom: 1px solid var(--color-stone);
        position: sticky;
        top: 0;
        z-index: 20;
      }

      .site-header__inner {
        max-width: var(--content-max);
        margin: 0 auto;
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        justify-content: space-between;
        gap: 20px 28px;
        padding: 18px 40px;
      }

      .brand {
        display: flex;
        align-items: center;
        gap: 14px;
      }

      .brand img {
        display: block;
        mix-blend-mode: multiply;
      }

      .brand__logo {
        height: 50px;
        width: auto;
      }

      .brand__wordmark {
        height: 40px;
        width: auto;
      }

      .nav {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        justify-content: flex-end;
        gap: 10px 18px;
      }

      .nav__link {
        font-size: 14px;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        color: var(--color-charcoal);
      }

      .nav__link:hover,
      .nav__link[aria-current='page'] {
        color: var(--color-deep-rose);
      }

      .nav__donate {
        display: inline-block;
        padding: 9px 20px;
        background: var(--color-deep-rose);
        color: var(--color-white);
        border-radius: 999px;
        font-size: 14px;
        text-transform: uppercase;
        letter-spacing: 0.05em;
      }

      .nav__donate:hover {
        background: var(--color-deep-rose-hover);
        color: var(--color-white);
      }

      main {
        display: block;
      }
    </style>
  </body>
</html>
